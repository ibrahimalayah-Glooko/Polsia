# Copy to .env and fill in as needed. Only API_KEY and SANDBOX_MODE are required to boot.
API_KEY=dev-key
SANDBOX_MODE=true

POSTGRES_USER=polsia
POSTGRES_PASSWORD=polsia_password
POSTGRES_DB=polsia

CLAUDE_CLI_PATH=/usr/local/bin/claude

# Local LLM alternative to the Claude CLI (no login required) — requires `ollama serve` running on the host
LLM_BACKEND=claude
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=hermes3

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Twitter/X
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# SendGrid
SENDGRID_API_KEY=

# Tavily (competitor research web search)
TAVILY_API_KEY=

# GitHub (code generation agent PRs)
GITHUB_TOKEN=
